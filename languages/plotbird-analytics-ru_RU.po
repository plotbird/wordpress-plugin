#: admin/views/settings-page.php:160
msgid "\"Site language\" follows the language of WordPress, so usually there is nothing to choose here. Pick one only if these screens should be in another language than the rest of the admin."
msgstr "«Язык сайта» повторяет язык WordPress, поэтому обычно выбирать здесь нечего. Укажите другой, только если эти экраны должны быть на ином языке, чем остальная админка."

#: includes/class-plotbird-stats.php:208
msgid "%1$d min %2$d s"
msgstr "%1$d мин %2$d с"

#: includes/class-plotbird-stats.php:203
msgid "%d min"
msgstr "%d мин"

#: includes/class-plotbird-stats.php:192
msgid "%d s"
msgstr "%d с"

#: admin/views/stats-page.php:119
msgid "%s online now"
msgstr "%s сейчас на сайте"

#: admin/views/stats-page.php:28
